+	}
+	if auth.Attributes == nil {
+		auth.Attributes = make(map[string]string)
+	}
+	priority, ok := authFileIntValue(auth.Metadata[key])
+	if !ok || priority == 0 {
+		delete(auth.Attributes, key)
+		return
+	}
+	auth.Attributes[key] = strconv.Itoa(priority)
