+func (h *Host) callRequestFinalizer(ctx context.Context, record capabilityRecord, finalizer pluginapi.RequestFinalizer, req pluginapi.RequestFinalizeRequest) (out pluginapi.RequestFinalizeResponse, ok bool) {
+	if h == nil || finalizer == nil || h.isPluginFused(record.id) || !h.recordCurrent(record) {
+		return pluginapi.RequestFinalizeResponse{}, false
+	}
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			h.fusePlugin(record.id, "RequestFinalizer.FinalizeRequest", recovered)
+			out = pluginapi.RequestFinalizeResponse{}
+			ok = false
+		}
+	}()
+	resp, errFinalize := finalizer.FinalizeRequest(ctx, req)
+	if errFinalize != nil {
+		log.Warnf("pluginhost: request finalizer %s failed: %v", record.id, errFinalize)
+		return pluginapi.RequestFinalizeResponse{}, false
+	}
+	return resp, true
+}
